# --------------------
# OpenWeatherMap
# --------------------
OWM_API_KEY=your_openweathermap_api_key_here

# --------------------
# Twilio (Common)
# --------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# --------------------
# Twilio SMS
# --------------------
TWILIO_FROM=your_twilio_sms_number_here
TWILIO_TO=your_verified_number_here

# --------------------
# Twilio WhatsApp
# Sandbox sender must always be whatsapp:+14155238886
# Receiver must be whatsapp:+<your-phone>
# --------------------
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+your_verified_number_here
